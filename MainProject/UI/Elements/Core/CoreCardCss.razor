<style>
    .core-card {
        display: flex;
        flex-direction: column;
        transition: transform @(AppMeasures.Duration.Fast)s, box-shadow @(AppMeasures.Duration.Fast)s;
        overflow: hidden;
        box-sizing: border-box;
    }

        .core-card.clickable {
            cursor: pointer;
        }

            .core-card.clickable:active {
                transform: scale(@AppMeasures.Scale.CardPressed);
            }

            .core-card.clickable:focus-visible {
                outline: @(AppMeasures.Border.Medium)px solid @(AppColors.Primary.ToRgbaHex(true));
                outline-offset: @(AppMeasures.Space.Px2)px;
            }
</style>