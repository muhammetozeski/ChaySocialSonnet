@namespace ChaySocialSonnet.MainProject.UI.Elements.Cards
<style>
    .post-card {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px4)px;
        text-align: left;
    }

    .post-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Small)px;
    }

    .post-card-author {
        margin: 0;
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Semibold);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    .post-card-text {
        margin: 0;
        font-size: @(AppMeasures.Font.Normal)px;
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        line-height: @(AppMeasures.LineHeight.Snug);
        white-space: pre-wrap;
        word-break: break-word;
    }

    .post-card-time {
        margin: 0;
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
    }

    .post-card-actions {
        display: flex;
        gap: @(AppMeasures.Space.Medium)px;
        margin-top: @(AppMeasures.Space.Px4)px;
    }

    .post-card-action {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px4)px;
        background: none;
        border: none;
        cursor: pointer;
        font-size: @(AppMeasures.Font.Small)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Small)px;
    }

    .post-card-action:disabled {
        opacity: @AppMeasures.Opacity.Disabled;
        cursor: not-allowed;
    }

    .post-card-action--active {
        color: @(AppColors.Error.ToRgbaHex(true));
    }

    .post-card-report-sent {
        margin: 0;
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @(AppColors.TextSuccess.ToRgbaHex(true));
    }

    .post-card-comments {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Small)px;
        margin-top: @(AppMeasures.Space.Small)px;
        padding-top: @(AppMeasures.Space.Small)px;
        border-top: 1px solid @(AppColors.GlassBorderDefault.ToRgbaHex(true));
    }

    .post-card-comment {
        display: flex;
        gap: @(AppMeasures.Space.Px8)px;
        font-size: @(AppMeasures.Font.Small)px;
    }

    .post-card-comment-author {
        font-weight: @(AppMeasures.Weight.Semibold);
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
        flex-shrink: 0;
    }

    .post-card-comment-text {
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
        word-break: break-word;
    }

    .post-card-comment-composer {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        margin-top: @(AppMeasures.Space.Px4)px;
    }

    .post-card-comment-composer .core-input-group {
        flex: 1;
    }
</style>
