@namespace ChaySocialSonnet.MainProject.UI.Layout

@{
    string cssVars = AppStyles.BuildCssVariables();
    string aurora = AppStyles.BuildAuroraBackground();
    string textColor = AppColors.TextPrimary.ToRgbaHex(true);
    string warningBg = AppColors.Warning.ToRgbaHex(true);
    string warningFg = AppColors.BackgroundDeep.ToRgbaHex(true);
}

<style>
    @((MarkupString)cssVars)

    /* Self-hosted display/body font so text renders identically everywhere instead of depending on
       whichever system font a given OS/browser happens to substitute for "sans-serif". Single variable
       file covers weights 400-700 (see MainProject/wwwroot/fonts/Quicksand-Variable.woff2). Emoji are
       deliberately left to the OS's own native emoji font (every platform this app targets already ships
       a full-color one) rather than bundling a 25MB custom emoji font for no visible benefit. */
    @@font-face {
        font-family: "Quicksand";
        src: url("_content/MainProject/fonts/Quicksand-Variable.woff2") format("woff2");
        font-weight: 400 700;
        font-display: swap;
    }

    body {
        margin: 0;
        padding: 0;
        min-height: @(AppMeasures.Viewport.Full)vh;
        overflow-x: hidden;
        font-family: "Quicksand", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: @textColor;
        @((MarkupString)aurora)
        background-attachment: fixed;
        background-repeat: no-repeat;
        background-size: cover;
    }

    .app-page {
        display: flex;
        flex-direction: column;
        min-height: @(AppMeasures.Viewport.Full)vh;
        position: relative;
    }

        .app-page.has-bottom-nav {
            padding-bottom: @(AppMeasures.Space.Px90)px;
        }

    main {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
    }

    .content {
        flex: 1;
        position: relative;
        animation: pageFadeSlideIn @(AppMeasures.Duration.Normal)s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }

    #blazor-error-ui {
        background: @warningBg;
        color: @warningFg;
        bottom: 0;
        left: 0;
        width: @(AppMeasures.Percent.Full)%;
        position: fixed;
        padding: 0.6rem 1.25rem 0.7rem 1.25rem;
        display: none;
        z-index: @(AppMeasures.ZLayer.Toast);
    }

        #blazor-error-ui .dismiss {
            cursor: pointer;
            position: absolute;
            right: 0.75rem;
            top: 0.5rem;
        }

    @@keyframes pageFadeSlideIn {
        0% {
            opacity: 0;
            transform: translateY(@(AppMeasures.Space.Px16)px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

