@inherits LayoutComponentBase
@inject NavigationManager NavManager
@implements IDisposable

<div class="app-page @(_showBottomNav ? "has-bottom-nav" : "")">
    <main>
        <article class="content">
            @Body
        </article>
    </main>

    @if (_showBottomNav)
    {
        <AppBottomNav />
    }
</div>


@code {

    private bool _showBottomNav = false;

    protected override void OnInitialized()
    {

        NavManager.LocationChanged += HandleLocationChanged;
        Events.MainEvents.OnThemeChanged.Subscribe(HandleThemeChanged);
        EvaluateBottomNavVisibility(NavManager.Uri);
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {

        EvaluateBottomNavVisibility(e.Location);
        StateHasChanged();
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void EvaluateBottomNavVisibility(string uri)
    {
        var absolutePath = NavigationRouting.ToAbsoluteLowercasePath(NavManager, uri);
        _showBottomNav = NavigationRouting.IsBottomNavigationRoute(absolutePath);
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= HandleLocationChanged;
        Events.MainEvents.OnThemeChanged.Unsubscribe(HandleThemeChanged);
    }
}
