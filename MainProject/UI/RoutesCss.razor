@namespace ChaySocialSonnet.MainProject.UI
<style>
    .route-error {
        min-height: @(AppMeasures.Viewport.Full)vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: @(AppMeasures.Space.Small)px;
        padding: @(AppMeasures.Space.Large)px;
        text-align: center;
    }

    .route-error-title {
        margin: 0;
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    .route-error-subtitle {
        margin: 0 0 @(AppMeasures.Space.Small)px 0;
        font-size: @(AppMeasures.Font.Normal)px;
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    .route-error-reload {
        border: none;
        cursor: pointer;
        padding: @(AppMeasures.Space.Small)px @(AppMeasures.Space.Large)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        font-size: @(AppMeasures.Font.Normal)px;
        font-weight: @(AppMeasures.Weight.Semibold);
        background: @(AppColors.Primary.ToRgbaHex(true));
        color: @(AppColors.TextOnAccent.ToRgbaHex(true));
    }
</style>
