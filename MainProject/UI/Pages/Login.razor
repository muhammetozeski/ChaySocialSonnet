@attribute [Route("/login")]
@inherits ChaySocialSonnet.MainProject.UI.Layout.Architecture.PageBase
@inject IIdentityKeyStore KeyStore
@inject IdentityApiClient ApiClient
<PageTitle>@AppConstants.LoginMenuTitle</PageTitle>

<div class="login-screen">
    <GlassCard CustomClass="login-card">
        <h1 class="login-title">@AppConstants.LoginMenuTitle</h1>
        <p class="login-subtitle">@AppConstants.LoginMenuSubtitle</p>

        @if (_identity is null)
        {
            <PrimaryButton IsFullWidth="true" Disabled="@_isCreating" OnClick="HandleCreateAccount">
                @if (_isCreating)
                {
                    <CoreSpinner SizePx="@AppMeasures.Size.Px20" Color="@AppColors.TextOnAccent" />
                }
                else
                {
                    <span>Create my account</span>
                }
            </PrimaryButton>
        }
        else
        {
            <div class="login-identity-box">
                <p class="login-identity-label">Your identity</p>
                <p class="login-identity-value">@_identity.PublicId</p>
            </div>
            @if (_errorMessage is not null)
            {
                <p class="login-error">@_errorMessage</p>
            }
            <PrimaryButton IsFullWidth="true" Disabled="@_isSigningIn" OnClick="HandleContinue">
                @if (_isSigningIn)
                {
                    <CoreSpinner SizePx="@AppMeasures.Size.Px20" Color="@AppColors.TextOnAccent" />
                }
                else
                {
                    <span>Continue</span>
                }
            </PrimaryButton>
        }
    </GlassCard>
</div>

<LoginCss />

@code {
    ChayIdentity? _identity;
    bool _isCreating;
    bool _isSigningIn;
    string? _errorMessage;

    /// <summary> Generates a brand-new ML-DSA/ML-KEM identity entirely on this device; the private keys never leave it. </summary>
    async Task HandleCreateAccount()
    {
        _isCreating = true;
        StateHasChanged();
        await Task.Yield();
        _identity = IdentityService.GenerateIdentity();
        _isCreating = false;
    }

    /// <summary> Registers the identity's public keys with the server, then proves ownership via challenge-response before signing in — the private key is never sent. </summary>
    async Task HandleContinue()
    {
        _isSigningIn = true;
        _errorMessage = null;
        StateHasChanged();

        await ApiClient.RegisterAsync(_identity!, AppConstants.GuestDisplayName);
        bool verified = await ApiClient.SignInAsync(_identity!);
        if (!verified)
        {
            _errorMessage = "Could not verify your identity with the server. Please try again.";
            _isSigningIn = false;
            return;
        }

        await KeyStore.SaveAsync(_identity!);
        AuthService.SignIn(_identity!);
        NavManager.NavigateTo("/home");
    }
}
