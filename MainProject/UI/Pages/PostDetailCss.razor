@namespace ChaySocialSonnet.MainProject.UI.Pages
<style>
    .post-detail-screen {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Medium)px;
        padding: @(AppMeasures.Space.Large)px;
    }

    .post-detail-loading {
        display: flex;
        justify-content: center;
        padding: @(AppMeasures.Space.Large)px;
    }

    .post-detail-not-found {
        margin: 0;
        text-align: center;
        padding: @(AppMeasures.Space.Large)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
    }
</style>
