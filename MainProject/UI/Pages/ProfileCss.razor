@namespace ChaySocialSonnet.MainProject.UI.Pages
<style>
    .profile-screen {
        min-height: @(AppMeasures.Viewport.Full)vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: @(AppMeasures.Space.Medium)px;
        padding: @(AppMeasures.Space.Large)px;
    }

    .profile-stats {
        display: flex;
        gap: @(AppMeasures.Space.Medium)px;
        font-size: @(AppMeasures.Font.Small)px;
        color: @(AppColors.TextSecondary.ToRgbaHex(true));
    }

    .profile-posts-loading {
        display: flex;
        justify-content: center;
        padding: @(AppMeasures.Space.Large)px;
    }

    .profile-posts-empty {
        margin: 0;
        text-align: center;
        padding: @(AppMeasures.Space.Large)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
    }

    .profile-card {
        width: @(AppMeasures.Percent.Full)%;
        max-width: @(AppMeasures.Size.Px420)px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: @(AppMeasures.Space.Medium)px;
        text-align: center;
    }

    .profile-avatar {
        font-size: @(AppMeasures.Font.Giant)px;
    }

    .profile-name {
        margin: 0;
        font-size: @(AppMeasures.Font.Title)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        color: @(AppColors.TextPrimary.ToRgbaHex(true));
    }

    .profile-identity-row {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Small)px;
        width: @(AppMeasures.Percent.Full)%;
        padding: @(AppMeasures.Space.Medium)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
    }

    .profile-identity {
        margin: 0;
        flex: 1;
        min-width: 0;
        font-family: ui-monospace, "Cascadia Code", "Roboto Mono", Consolas, monospace;
        font-size: @(AppMeasures.Font.Small)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        word-break: break-all;
        text-align: left;
    }

    .profile-backup-prompt {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Small)px;
        width: @(AppMeasures.Percent.Full)%;
    }

    .profile-backup-hint {
        margin: 0;
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
    }
</style>
