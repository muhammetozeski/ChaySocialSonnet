@attribute [Route("/home")]
@inherits ChaySocialSonnet.MainProject.UI.Layout.Architecture.PageBase
@inject PostApiClient PostApi
@inject FollowApiClient FollowApi
<PageTitle>Home</PageTitle>

<div class="home-screen">
    <HeroFeedPanel>
        <Hero>
            <GradientCard CustomClass="home-hero">
                <span class="home-hero-emoji">🍵✨</span>
                <h1 class="home-hero-title">Welcome to @AppConstants.AppNameHumanReadable</h1>
                <p class="home-hero-subtitle">So glad you're here — your feed will start filling up soon.</p>
            </GradientCard>
        </Hero>
        <Intro>
            @if (ViewerPublicId is not null)
            {
                <GlassCard CustomClass="home-composer">
                    <CoreInput Placeholder="What's on your mind?" @bind-Value="_draftText" />
                    <PrimaryButton Disabled="@_posting.IsBusy" OnClick="HandlePost">
                        @if (_posting.IsBusy)
                        {
                            <CoreSpinner SizePx="@AppMeasures.Size.Px20" Color="@AppColors.TextOnAccent" />
                        }
                        else
                        {
                            <span>Post</span>
                        }
                    </PrimaryButton>
                </GlassCard>
                @if (_posting.ErrorMessage is not null)
                {
                    <p class="home-composer-error">@_posting.ErrorMessage</p>
                }
            }
        </Intro>
        <Feed>
            @if (ViewerPublicId is not null)
            {
                <div class="home-feed-tabs">
                    <button class="home-feed-tab @(_activeTab == FeedTab.ForYou ? "home-feed-tab--active" : "")" @onclick="() => HandleSelectTab(FeedTab.ForYou)">For You</button>
                    <button class="home-feed-tab @(_activeTab == FeedTab.Following ? "home-feed-tab--active" : "")" @onclick="() => HandleSelectTab(FeedTab.Following)">Following</button>
                </div>
            }

            @if (CurrentPosts is null)
            {
                <div class="home-feed-loading">
                    <CoreSpinner />
                </div>
            }
            else if (CurrentPosts.Count == 0)
            {
                <p class="home-empty-feed">@EmptyFeedMessage</p>
            }
            else
            {
                @foreach (PostSummary post in CurrentPosts)
                {
                    <PostCard Post="post" ViewerPublicId="@ViewerPublicId" OnDeleted="HandlePostDeleted" />
                }
            }
        </Feed>
    </HeroFeedPanel>
</div>

<HomeCss />

@code {
    enum FeedTab { ForYou, Following }

    const int RecentPostsCount = 20;

    IReadOnlyList<PostSummary>? _posts;
    IReadOnlyList<PostSummary>? _followingPosts;
    FeedTab _activeTab = FeedTab.ForYou;
    AsyncOperationState _posting = null!;
    string _draftText = string.Empty;

    string? ViewerPublicId => AuthService.CurrentIdentity?.PublicId;

    IReadOnlyList<PostSummary>? CurrentPosts => _activeTab == FeedTab.ForYou ? _posts : _followingPosts;

    string EmptyFeedMessage => _activeTab == FeedTab.ForYou
        ? "No posts yet — be the first to share something!"
        : "Nobody you follow has posted yet.";

    protected override async Task OnInitializedAsync()
    {
        _posting = new AsyncOperationState(StateHasChanged);
        _posts = await PostApi.GetRecentPostsAsync(RecentPostsCount, ViewerPublicId);
    }

    async Task HandleSelectTab(FeedTab tab)
    {
        _activeTab = tab;
        if (tab == FeedTab.Following && _followingPosts is null)
        {
            await LoadFollowingFeedAsync();
        }
    }

    /// <summary> Merges each followed identity's own recent posts into one feed, newest first. Fine at this scale — revisit with a dedicated server-side query if the following list or post volume grows large. </summary>
    async Task LoadFollowingFeedAsync()
    {
        if (ViewerPublicId is null)
        {
            return;
        }

        IReadOnlyList<string> followingIds = await FollowApi.GetFollowingIdsAsync(ViewerPublicId);
        var merged = new List<PostSummary>();
        foreach (string id in followingIds)
        {
            merged.AddRange(await PostApi.GetPostsByAuthorAsync(id, RecentPostsCount, ViewerPublicId));
        }
        merged.Sort((a, b) => b.CreatedAt.CompareTo(a.CreatedAt));
        _followingPosts = merged.Count > RecentPostsCount ? merged.Take(RecentPostsCount).ToList() : merged;
    }

    async Task HandlePost()
    {
        if (string.IsNullOrWhiteSpace(_draftText) || ViewerPublicId is null)
        {
            return;
        }

        await _posting.RunAsync(async () =>
        {
            PostSummary created = await PostApi.CreatePostAsync(_draftText);
            _draftText = string.Empty;
            _posts = [created, .. _posts ?? []];
        });
    }

    void HandlePostDeleted(string postId)
    {
        _posts = _posts?.Where(post => post.Id != postId).ToList();
        _followingPosts = _followingPosts?.Where(post => post.Id != postId).ToList();
        StateHasChanged();
    }
}
