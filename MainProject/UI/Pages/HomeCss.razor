@namespace ChaySocialSonnet.MainProject.UI.Pages
<style>
    .home-screen {
        min-height: @(AppMeasures.Viewport.Full)vh;
        padding: @(AppMeasures.Space.Large)px;
    }

    .home-hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: @(AppMeasures.Space.Small)px;
    }

    .home-hero-emoji {
        font-size: @(AppMeasures.Font.Giant)px;
    }

    .home-hero-title {
        margin: 0;
        font-size: @(AppMeasures.Font.Title)px;
        font-weight: @(AppMeasures.Weight.Heavy);
    }

    .home-hero-subtitle {
        margin: 0;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
    }

    .home-feed-loading {
        display: flex;
        justify-content: center;
        padding: @(AppMeasures.Space.Large)px;
    }

    .home-empty-feed {
        margin: 0;
        text-align: center;
        padding: @(AppMeasures.Space.Large)px;
        color: @AppColors.TextMuted;
        font-size: @(AppMeasures.Font.Normal)px;
    }
</style>
