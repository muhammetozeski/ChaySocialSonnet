@namespace ChaySocialSonnet.MainProject.UI.Pages
<style>
    .home-screen {
        min-height: @(AppMeasures.Viewport.Full)vh;
        padding: @(AppMeasures.Space.Large)px;
    }

    .home-hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: @(AppMeasures.Space.Small)px;
    }

    .home-hero-emoji {
        font-size: @(AppMeasures.Font.Giant)px;
    }

    .home-hero-title {
        margin: 0;
        font-size: @(AppMeasures.Font.Title)px;
        font-weight: @(AppMeasures.Weight.Heavy);
    }

    .home-hero-subtitle {
        margin: 0;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
    }

    .home-feed-tabs {
        display: flex;
        flex-direction: row;
        gap: @(AppMeasures.Space.Small)px;
        margin-bottom: @(AppMeasures.Space.Small)px;
    }

    .home-feed-tab {
        flex: 1;
        border: none;
        cursor: pointer;
        padding: @(AppMeasures.Space.Small)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Semibold);
        background: @(AppColors.SurfaceSubtle.ToRgbaHex(true));
        color: @(AppColors.TextMuted.ToRgbaHex(true));
    }

    .home-feed-tab--active {
        background: @(AppColors.Primary.ToRgbaHex(true));
        color: @(AppColors.TextOnAccent.ToRgbaHex(true));
    }

    .home-feed-loading {
        display: flex;
        justify-content: center;
        padding: @(AppMeasures.Space.Large)px;
    }

    .home-empty-feed {
        margin: 0;
        text-align: center;
        padding: @(AppMeasures.Space.Large)px;
        color: @(AppColors.TextMuted.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.Normal)px;
    }

    .home-composer {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: @(AppMeasures.Space.Small)px;
    }

    .home-composer .core-input-group {
        flex: 1;
    }

    .home-composer-error {
        margin: @(AppMeasures.Space.Px4)px 0 0;
        font-size: @(AppMeasures.Font.Small)px;
        color: @(AppColors.TextDanger.ToRgbaHex(true));
    }
</style>
