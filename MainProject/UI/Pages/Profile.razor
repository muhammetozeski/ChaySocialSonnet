@attribute [Route("/profile")]
@inherits ChaySocialSonnet.MainProject.UI.Layout.Architecture.PageBase
@inject IIdentityKeyStore KeyStore
@inject IJSRuntime JsRuntime
@inject FollowApiClient FollowApi
@inject PostApiClient PostApi
@using System.Globalization
<PageTitle>Profile</PageTitle>

<div class="profile-screen">
    <GlassCard CustomClass="profile-card">
        <span class="profile-avatar">@AppConstants.Avatar.DefaultUser</span>
        <h1 class="profile-name">@_displayName</h1>

        <div class="profile-identity-row">
            <p class="profile-identity">@(AuthService.CurrentIdentity?.PublicId)</p>
            <IconButton OnClick="HandleCopyIdentity">
                <span>📋</span>
            </IconButton>
        </div>
        @if (_copyFeedback is not null)
        {
            <CoreChip Text="@_copyFeedback" />
        }

        <div class="profile-stats">
            <span>@_followStatus.FollowerCount followers</span>
            <span>@_followStatus.FollowingCount following</span>
        </div>

        @if (!_showBackupPrompt)
        {
            <SecondaryButton IsFullWidth="true" OnClick="() => _showBackupPrompt = true">
                <span>Back up identity</span>
            </SecondaryButton>
        }
        else
        {
            <div class="profile-backup-prompt">
                <CoreInput Type="password" Placeholder="Choose a passphrase" @bind-Value="_backupPassphrase" />
                <PrimaryButton IsFullWidth="true" Disabled="@string.IsNullOrWhiteSpace(_backupPassphrase)" OnClick="HandleDownloadBackup">
                    <span>Download backup</span>
                </PrimaryButton>
            </div>
            <p class="profile-backup-hint">Keep this passphrase — you'll need it to restore. The file never leaves your device unencrypted.</p>
        }

        <DangerButton IsFullWidth="true" OnClick="HandleSignOut">
            <span>Sign out</span>
        </DangerButton>
    </GlassCard>

    @if (_posts is null)
    {
        <div class="profile-posts-loading">
            <CoreSpinner />
        </div>
    }
    else if (_posts.Count == 0)
    {
        <p class="profile-posts-empty">You haven't posted anything yet.</p>
    }
    else
    {
        @foreach (PostSummary post in _posts)
        {
            <PostCard Post="post" ViewerPublicId="@AuthService.CurrentIdentity?.PublicId" OnDeleted="HandlePostDeleted" />
        }
    }
</div>

<ProfileCss />

@code {
    const int OwnPostsCount = 50;

    string? _copyFeedback;
    Backend.FollowStatusResponse _followStatus = new(false, 0, 0);
    IReadOnlyList<PostSummary>? _posts;
    bool _showBackupPrompt;
    string _backupPassphrase = string.Empty;

    protected override void OnInitialized()
    {
        RequireAuth = true;
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        string? publicId = AuthService.CurrentIdentity?.PublicId;
        if (publicId is null)
        {
            return;
        }

        _followStatus = await FollowApi.GetStatusAsync(publicId, publicId);
        _posts = await PostApi.GetPostsByAuthorAsync(publicId, OwnPostsCount, publicId);
    }

    void HandlePostDeleted(string postId)
    {
        _posts = _posts?.Where(post => post.Id != postId).ToList();
        StateHasChanged();
    }

    string _displayName => string.IsNullOrWhiteSpace(UserProfileService.LoggedUserProfileData?.DisplayName)
        ? AppConstants.GuestDisplayName
        : UserProfileService.LoggedUserProfileData!.DisplayName;

    /// <summary> Copies the identity to the clipboard via the browser's own clipboard API and briefly shows a "Copied!"/"Copy failed" chip. The clipboard call can legitimately be denied (no user-gesture context, blocked permission, non-secure context), so a failure here must not crash the page. </summary>
    async Task HandleCopyIdentity()
    {
        if (AuthService.CurrentIdentity is null)
        {
            return;
        }

        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", AuthService.CurrentIdentity.PublicId);
            _copyFeedback = "Copied!";
        }
        catch (JSException exception)
        {
            Log(exception, LogLevel.Warning);
            _copyFeedback = "Couldn't copy — select the text instead";
        }

        StateHasChanged();
        await Task.Delay(TimeSpan.FromSeconds(double.Parse(AppMeasures.Duration.Longer, CultureInfo.InvariantCulture)));
        _copyFeedback = null;
        StateHasChanged();
    }

    async Task HandleSignOut()
    {
        await KeyStore.ClearAsync();
        AuthService.SignOut();
        NavManager.NavigateTo("/login");
    }

    /// <summary> Encrypts the identity under the chosen passphrase entirely on-device and hands the browser a data URI to download — no server round trip, no plaintext private key ever written to disk. </summary>
    async Task HandleDownloadBackup()
    {
        if (AuthService.CurrentIdentity is null || string.IsNullOrWhiteSpace(_backupPassphrase))
        {
            return;
        }

        byte[] blob = IdentityBackupService.EncryptBackup(AuthService.CurrentIdentity, _backupPassphrase);
        string base64 = Convert.ToBase64String(blob);
        string fileName = $"chay-backup-{AuthService.CurrentIdentity.PublicId}.bin";
        string script = $"const a=document.createElement('a');a.href='data:application/octet-stream;base64,{base64}';a.download='{fileName}';document.body.appendChild(a);a.click();a.remove();";

        try
        {
            await JsRuntime.InvokeVoidAsync("eval", script);
        }
        catch (JSException exception)
        {
            Log(exception, LogLevel.Warning);
        }

        _backupPassphrase = string.Empty;
        _showBackupPrompt = false;
    }
}
