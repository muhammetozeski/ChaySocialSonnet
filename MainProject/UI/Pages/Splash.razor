@attribute [Route("/")]
@inherits ChaySocialSonnet.MainProject.UI.Layout.Architecture.PageBase
@inject IIdentityKeyStore KeyStore
@inject IdentityApiClient ApiClient
<PageTitle>@AppConstants.AppNameHumanReadable</PageTitle>

<div class="splash-screen">
    <span class="splash-logo">🍵</span>
    <CoreSpinner />
    <p class="splash-tagline">@AppConstants.AppTagline</p>
</div>

<SplashCss />

@code {
    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(UiConstants.Delays.SplashMinimumMs);

        ChayIdentity? savedIdentity = await KeyStore.LoadAsync();
        if (savedIdentity is not null)
        {
            // Re-verify with the server rather than trusting local storage alone: LocalIdentityRegistry
            // is in-memory, so a server restart during development wipes every registration even though
            // the device still remembers its identity — without this check the app would silently show
            // a "signed in" UI for an identity the server has never heard of.
            bool verified = await ApiClient.SignInAsync(savedIdentity);
            if (verified)
            {
                AuthService.SignIn(savedIdentity);
                NavManager.NavigateTo("/home");
                return;
            }

            await KeyStore.ClearAsync();
        }

        NavManager.NavigateTo("/login");
    }
}
